[Unit]
Description=DougVoice - Wyoming satellite on :10700 for Douglas
After=network-online.target sound.target dougvoice-face.service
Wants=network-online.target dougvoice-face.service

[Service]
EnvironmentFile=/etc/dougvoice/dougvoice.env
ExecStart=/usr/bin/python3 /opt/dougvoice/dougvoice.py satellite
User=dougvoice
SupplementaryGroups=audio
NoNewPrivileges=yes
ProtectHome=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
