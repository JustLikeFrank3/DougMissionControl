[Unit]
Description=Open WebUI - chat with Douglas on :8080, from any tailnet device
After=network-online.target llama-server.service
Wants=network-online.target

[Service]
# A user of its own (webui-setup.sh makes it): its database holds every
# conversation had in it and a token that speaks to Douglas, and is nobody
# else's to read.
User=open-webui
Group=open-webui
StateDirectory=open-webui
StateDirectoryMode=0700
UMask=0077
Environment=DATA_DIR=/var/lib/open-webui HOME=/var/lib/open-webui
# onnxruntime (inside this service) reports usage to Microsoft unless told
# not to. Nothing in this house needs that.
Environment=ORT_DISABLE_TELEMETRY=1
EnvironmentFile=/etc/douglas/open-webui.env
ExecStart=/opt/open-webui/bin/open-webui serve --host 0.0.0.0 --port ${OPEN_WEBUI_PORT}
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
