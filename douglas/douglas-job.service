[Unit]
Description=douglas-job - one job on a copy of a repository, fenced in (douglas-work's runner)
After=douglas-work.service
StartLimitIntervalSec=0

[Service]
User=douglas-job
Group=douglas-job
SupplementaryGroups=douglas-spool
UMask=0007
# Its work trees are in its private /var/tmp: on the disk, and removed by
# systemd, as root, each time the unit ends. It has no home, and Python is
# started with -I, which reads nothing from a home or from the environment.
Environment=WORK_JOBS=/var/lib/douglas-spool WORK_JOB_DIR=/var/tmp/douglas-job HOME=/nonexistent
ExecStart=/usr/bin/python3 -I /opt/douglas/douglas-work.py runner
# One job a run: when it is over the runner exits, and the unit ending
# clears away whatever a command left running, at once and without asking.
# Then it waits for the next.
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGKILL
TimeoutStopSec=5

# The fence, from the outside in (douglas-work.py has the rest). A job runs
# commands the model chooses, over code somebody else may have written.
#
# Its own user, which owns nothing and can become nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
# Refused outright: what a job has no use for, and io_uring, which can open
# sockets past the rule on address families below.
SystemCallFilter=~@mount @swap @reboot @raw-io @module @cpu-emulation @obsolete @clock io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
# A file system with nothing of the owner's in it: the system's programs to
# read, and of everything that holds state (/var, /run, /srv, /opt, /home)
# only its own work trees, the directory it shares with the manager, and its
# own program.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
TemporaryFileSystem=/var:ro /run:ro /srv:ro /opt:ro /mnt:ro /media:ro /boot:ro
BindPaths=/var/lib/douglas-spool
# Shared memory and message queues of its own: /dev/shm would otherwise be
# the machine's, where what a command left would outlive the job.
PrivateIPC=yes
RemoveIPC=yes
TemporaryFileSystem=/dev/shm:rw,nosuid,nodev,size=1G,mode=1777
BindReadOnlyPaths=/opt/douglas/douglas-work.py
InaccessiblePaths=/etc/douglas -/etc/flightsim -/etc/ssh -/etc/NetworkManager -/etc/netplan -/etc/sudoers.d
# A network of its own with nothing on it: a loopback that only the job's
# own programs are on (a test may start a server and talk to it), and no way
# to any other machine or to anything on this one, the model server
# included. What a job asks the model, the manager asks for it.
PrivateNetwork=yes
# (AF_NETLINK is how a program asks which interfaces there are: the runner
# asks, to see that this network is its own, before it lets a command on it.)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost
# Room to work, and not all of the machine's: the voice comes first.
MemoryMax=16G
TasksMax=512
CPUQuota=800%
CPUWeight=20
Nice=10
IOWeight=20
LimitFSIZE=2G
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
