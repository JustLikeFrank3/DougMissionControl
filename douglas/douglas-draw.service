[Unit]
Description=douglas-draw - Douglas's hand, an image model on :8083 (stable-diffusion.cpp, Vulkan)
After=network-online.target llama-server.service
Wants=network-online.target

[Service]
User=douglas
Group=douglas
SupplementaryGroups=render video
# DRAW_MODEL, DRAW_VAE, DRAW_CLIP_L, DRAW_T5XXL, DRAW_HOST, DRAW_PORT and
# DRAW_ARGS. ${X} is one argument, $X is split on whitespace, so DRAW_ARGS
# can hold any number of flags. provision.sh enables this unit only once the
# model file exists.
EnvironmentFile=/etc/douglas/draw.env
# A picture is made from words on this machine and needs nothing from any
# other, so the service is cut off from every address but this machine's own.
# Only douglas-voice talks to it: what is asked for and what comes back stay
# here.
IPAddressDeny=any
IPAddressAllow=localhost
StateDirectory=douglas-draw
WorkingDirectory=/var/lib/douglas-draw
ExecStart=/opt/stable-diffusion.cpp/build/bin/sd-server --listen-ip ${DRAW_HOST} --listen-port ${DRAW_PORT} --diffusion-model ${DRAW_MODEL} --vae ${DRAW_VAE} --clip_l ${DRAW_CLIP_L} --t5xxl ${DRAW_T5XXL} $DRAW_ARGS
TimeoutStartSec=5min
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
