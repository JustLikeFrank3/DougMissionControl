[Unit]
Description=douglas-memory - what Douglas remembers from one conversation to the next
Requires=douglas-memory-assistant.socket douglas-memory-owner.socket
After=douglas-memory-assistant.socket douglas-memory-owner.socket

[Service]
User=douglas-memory
Group=douglas-memory
EnvironmentFile=-/etc/douglas/memory.env
ExecStart=/usr/bin/python3 -I /opt/douglas/douglas-memory.py serve
StateDirectory=douglas-memory
StateDirectoryMode=0700
UMask=0077
# One file to its name and nothing to say to anybody. It has no network at
# all: its two doors are sockets systemd makes and hands it, and who may
# open which is decided by their groups (see the two .socket units), not by
# anything a caller says. What Douglas's other services keep is none of its
# business, and it runs nothing.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/etc/douglas -/var/lib/douglas -/var/lib/douglas-work -/var/lib/douglas-spool -/srv/models
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
MemoryMax=512M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
