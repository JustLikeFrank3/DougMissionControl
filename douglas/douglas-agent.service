[Unit]
Description=douglas-agent - Douglas's metrics, transcript and push-to-talk for Flight Deck
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/douglas/agent.env
ExecStart=/usr/bin/python3 /opt/douglas/douglas-agent.py
DynamicUser=yes
# Reads /proc, /sys and the voice pipeline's two files; writes nothing.
ReadOnlyPaths=/
ProtectHome=yes
NoNewPrivileges=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
